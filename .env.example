SHADOWPATH_DATA_DIR=./data
SHADOWPATH_DATABASE_URL=./data/shadowpath.db
SHADOWPATH_MAX_UPLOAD_BYTES=104857600
SHADOWPATH_MAX_ARCHIVE_ENTRIES=12000
SHADOWPATH_MAX_UNCOMPRESSED_BYTES=536870912
SHADOWPATH_MAX_COMPRESSION_RATIO=120
SHADOWPATH_ANALYSIS_POLL_SECONDS=1
SHADOWPATH_ENABLE_NVIDIA=false
SHADOWPATH_ALLOW_FIXTURES=false
# Comma-separated local UI origins. scripts/dev.ps1 sets this for -WebPort.
SHADOWPATH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
