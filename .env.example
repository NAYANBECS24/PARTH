SHADOWPATH_DATA_DIR=./data
SHADOWPATH_DATABASE_URL=./data/shadowpath.db
SHADOWPATH_TOOLCHAIN_DIR=./.toolcache
SHADOWPATH_MAX_UPLOAD_BYTES=104857600
SHADOWPATH_MAX_ARCHIVE_ENTRIES=12000
SHADOWPATH_MAX_UNCOMPRESSED_BYTES=536870912
SHADOWPATH_MAX_COMPRESSION_RATIO=120
SHADOWPATH_ANALYSIS_POLL_SECONDS=1
SHADOWPATH_AUTH_DISABLED=false
SHADOWPATH_ENABLE_NVIDIA=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MAX_TOKENS=1200
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_DAILY_CALL_BUDGET=25
MOBSF_API_URL=
MOBSF_API_KEY=
MOBSF_TIMEOUT_SECONDS=180
# Set true only to force-disable the optional MobSF static cross-validation adapter.
SHADOWPATH_DISABLE_MOBSF=false
# On-demand JADX source workspace limits. Source recovery only runs after an analyst requests it.
SHADOWPATH_SOURCE_WORKSPACE_MAX_FILES=1600
SHADOWPATH_SOURCE_WORKSPACE_MAX_FILE_BYTES=393216
SHADOWPATH_SOURCE_WORKSPACE_TIMEOUT_SECONDS=120
# Optional hash-only reputation lookups. Nothing is sent to a provider until an analyst presses Refresh.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=30
SHADOWPATH_ALLOW_FIXTURES=false
# Comma-separated local UI origins. scripts/dev.ps1 sets this for -WebPort.
SHADOWPATH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
